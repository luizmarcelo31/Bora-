generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// CORE: TENANT (Empresa)
// ============================================================

model Tenant {
  id        Int     @id @default(autoincrement())
  name      String
  type      String  @default("CONVENIENCE")
  email     String?
  phone     String?
  active    Boolean @default(true)
  suspended Boolean @default(false)

  // Ciclo de vida da empresa na plataforma (admin).
  status           StatusEmpresa @default(ATIVA)
  health           StatusSaude   @default(DESCONHECIDO)
  trialEndsAt      DateTime?
  lastActivityAt   DateTime?
  archivedAt       DateTime?
  suspendedAt      DateTime?
  suspensionReason String?

  subscription Subscription?
  tickets      Ticket[]
  featureFlags FeatureFlag[]

  users              User[]
  products           Product[]
  inventory          Inventory[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleItems          SaleItem[]
  cashBoxes          CashBox[]
  financialMovements FinancialMovement[]
  categories         Category[]

  suppliers       Supplier[]
  purchases       Purchase[]
  promotions      Promotion[]
  inventoryCounts InventoryCount[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  promotionItems      PromotionItem[]
  purchaseItems       PurchaseItem[]
  inventoryCountItems InventoryCountItem[]

  @@index([active])
  @@index([suspended])
  @@index([health])
  @@index([lastActivityAt])
  @@index([status])
}

// ============================================================
// CORE: USER (Usuario)
// ============================================================

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  password  String?
  role      Funcao    @default(FUNCIONARIO)
  tenantId  Int
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  active    Boolean   @default(true)
  lastLogin DateTime?

  createdSales Sale[] @relation("createdBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([role])
  @@index([active])
}

// Função do usuário dentro da empresa. SUPER_ADMIN é o nível plataforma.
enum Funcao {
  SUPER_ADMIN
  PROPRIETARIO
  GERENTE
  FINANCEIRO
  ESTOQUISTA
  CAIXA
  FUNCIONARIO
}

// ============================================================
// CORE: PRODUTO (Products)
// ============================================================

model Product {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  sku         String?
  barcode     String?
  description String?

  price  Int
  cost   Int?
  margin Float?

  category String?
  active   Boolean @default(true)

  imageUrl String?

  wholesalePrice       Int?
  wholesaleMinQuantity Int?

  inventory           Inventory?
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  promotionItems      PromotionItem[]
  inventoryCountItems InventoryCountItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([active])
  @@index([category])
}

// ============================================================
// CORE: ESTOQUE (Inventory & Stock Movements)
// ============================================================

model Inventory {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(0)

  minimumStock Int  @default(0)
  maximumStock Int?

  movements StockMovement[]

  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([productId])
}

model StockMovement {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  type     TipoMovimentacaoEstoque
  quantity Int
  reason   String?

  referenceId   Int?
  referenceType String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  DEVOLUCAO
  TRANSFERENCIA
  PERDA
  AVARIA
}

// ============================================================
// PDV (Point of Sale / Ponto de Venda)
// ============================================================

model Sale {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation("createdBy", fields: [userId], references: [id])

  cashBoxId Int?
  cashBox   CashBox? @relation(fields: [cashBoxId], references: [id])

  status StatusVenda @default(CONCLUIDA)

  subtotal Int
  discount Int @default(0)
  total    Int

  paymentMethod FormaPagamento @default(DINHEIRO)

  // Split dinheiro+pix: [{method, amount}] em centavos. Nulo = pagamento único (paymentMethod).
  payments Json?
  // Taxa maquineta (centavos) cobrada do cliente no cartão; no financeiro vira DESPESA separada.
  feeAmount Int @default(0)
  // Cupom não-fiscal: sequência diária por tenant + valores de troco.
  couponSeq     Int?
  couponDate    DateTime?
  receivedAmount Int?
  changeAmount   Int? @default(0)

  customerName  String?
  customerPhone String?

  idempotencyKey String?

  // ============================================================
  // Modo offline (Fase 3.1 — ADR-006)
  // ============================================================
  // offline: venda veio da fila local do dispositivo, não foi criada com a
  // rede no momento. Muda duas políticas no service: estoque pode ficar
  // negativo (a venda ocorreu, o dinheiro foi entregue) e caixa fechado não
  // recusa a venda. Divergências ficam registradas no audit.
  offline Boolean @default(false)
  // occurredAt: quando a venda aconteceu de fato. Venda sincronizada horas
  // depois recebe createdAt = hora do sync, e sem esta coluna o cupom diário e
  // o DRE cairiam no dia errado. `occurredAt ?? createdAt` é a data real.
  occurredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SaleItem[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, couponDate, couponSeq])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitPrice Int
  discount  Int @default(0)
  total     Int

  @@index([tenantId])
  @@index([saleId])
  @@index([productId])
}

enum StatusVenda {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

enum FormaPagamento {
  DINHEIRO
  CARTAO
  TRANSFERENCIA
  PIX
  CHEQUE
  OUTRO
  CREDITO
  DEBITO
}

// ============================================================
// CAIXA (Cash Box)
// ============================================================

model CashBox {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String

  status StatusCaixa @default(FECHADO)

  openingBalance Int  @default(0)
  currentBalance Int  @default(0)
  closingBalance Int?

  operatorName String?

  openedAt DateTime?
  closedAt DateTime?

  sales              Sale[]
  financialMovements FinancialMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

enum StatusCaixa {
  FECHADO
  ABERTO
}

// ============================================================
// FINANCEIRO (Financial)
// ============================================================

model FinancialMovement {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cashBoxId Int?
  cashBox   CashBox? @relation(fields: [cashBoxId], references: [id])

  type        TipoMovimentacaoFinanceira
  category    String
  description String

  amount Int

  paid   Boolean   @default(false)
  paidAt DateTime?

  movementDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@index([paid])
  @@index([movementDate])
}

enum TipoMovimentacaoFinanceira {
  RECEITA
  DESPESA
  TRANSFERENCIA
}

// ============================================================
// RELATORIOS (Reports)
// ============================================================

model DailyReport {
  id       Int @id @default(autoincrement())
  tenantId Int

  reportDate DateTime

  totalSales Int
  totalItems Int

  totalReceived Int
  totalExpenses Int

  createdAt DateTime @default(now())

  @@unique([tenantId, reportDate])
  @@index([tenantId])
}

// ============================================================
// AUDITORIA (Audit Log)
// ============================================================

model AuditLog {
  id       Int @id @default(autoincrement())
  tenantId Int

  action   String
  entity   String
  entityId Int

  userId    Int?
  userEmail String?

  changes String?
  details String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

// ============================================================
// CATEGORIAS (Produto e Financeiro)
// ============================================================

model Category {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name   String
  kind   TipoCategoria
  active Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, kind, name])
  @@index([tenantId])
  @@index([kind])
}

enum TipoCategoria {
  PRODUTO
  FINANCEIRO
}

// ============================================================
// SETTINGS (Configuracoes da empresa)
// ============================================================

model TenantSettings {
  id       Int @id @default(autoincrement())
  tenantId Int @unique

  enableDiscount Boolean @default(true)
  maxDiscount    Int?

  enableStockControl Boolean @default(true)
  allowNegativeStock Boolean @default(false)

  // Taxa maquineta em % (ex.: 2.99). 0 = sem acréscimo.
  feeCredit Float @default(0)
  feeDebit  Float @default(0)

  autoGenerateDailyReport Boolean @default(true)

  companyLogoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ============================================================
// PROMOCOES E PRECOS (Promotions & Prices)
// ============================================================

model Promotion {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String
  type  TipoPromocao
  value Int

  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)

  items PromotionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([active])
}

model PromotionItem {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([tenantId])
}

enum TipoPromocao {
  PERCENTUAL
  VALOR_FIXO
  COMBO
}

// ============================================================
// COMPRAS E FORNECEDORES (Purchases & Suppliers)
// ============================================================

model Supplier {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  document String?
  contact  String?
  email    String?
  phone    String?

  active Boolean @default(true)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([active])
}

model Purchase {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  status     StatusCompra @default(PENDENTE)
  total      Int
  invoiceKey String?

  receivedAt DateTime?

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseItem {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  unitCost Int
  total    Int

  @@index([tenantId])
  @@index([purchaseId])
  @@index([productId])
}

enum StatusCompra {
  PENDENTE
  RECEBIDA
  CANCELADA
}

// ============================================================
// INVENTARIO DE ESTOQUE (Inventory Count)
// ============================================================

model InventoryCount {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status StatusInventario @default(ABERTO)
  type   TipoInventario   @default(TOTAL)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  items InventoryCountItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

model InventoryCountItem {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  inventoryCountId Int
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  expectedQuantity Int
  countedQuantity  Int?
  divergence       Int?

  @@index([tenantId])
  @@index([inventoryCountId])
  @@index([productId])
}

enum StatusInventario {
  ABERTO
  CONCLUIDO
  CANCELADO
}

enum TipoInventario {
  TOTAL
  PARCIAL
}

// ============================================================
// PLATAFORMA: CICLO DE VIDA DA EMPRESA
// ============================================================

/**
 * Ciclo de vida da empresa dentro da plataforma.
 */
enum StatusEmpresa {
  TRIAL
  ATIVA
  SUSPENSA
  CANCELADA
  ARQUIVADA
}

/**
 * Sinais de risco calculados sobre atividade e assinatura da empresa.
 */
enum StatusSaude {
  SAUDAVEL
  ATENCAO
  CRITICA
  DESCONHECIDO
}

// ============================================================
// PLATAFORMA: PLANOS E ASSINATURAS
// ============================================================

enum StatusAssinatura {
  EXPERIMENTACAO
  ATIVA
  PENDENTE_PAGAMENTO
  SUSPENSA
  CANCELADA
  ARQUIVADA
}

enum CicloCobranca {
  MENSAL
  ANUAL
}

enum MotivoCancelamento {
  SOLICITACAO_CLIENTE
  FALHA_PAGAMENTO
  INADIMPLENCIA
  VIOLACAO_TERMO
  INICIADA_PLATAFORMA
}

model Plan {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  slug             String   @unique
  monthlyPrice     Int      @default(0) // centavos
  annualPrice      Int? // centavos
  maxUsers         Int?
  maxProducts      Int?
  maxSalesPerMonth Int?
  features         String[]
  trialDays        Int      @default(0)
  active           Boolean  @default(true)
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id           Int                 @id @default(autoincrement())
  tenantId     Int                 @unique
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       Int
  plan         Plan                @relation(fields: [planId], references: [id])
  status       StatusAssinatura    @default(EXPERIMENTACAO)
  billingCycle CicloCobranca       @default(MENSAL)
  startedAt    DateTime            @default(now())
  renewsAt     DateTime
  endsAt       DateTime?
  cancelledAt  DateTime?
  cancelReason MotivoCancelamento?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([renewsAt])
}

// ============================================================
// PLATAFORMA: SUPORTE
// ============================================================

enum StatusTicket {
  ABERTO
  EM_ANALISE
  AGUARDANDO_CLIENTE
  RESOLVIDO
  FECHADO
}

enum PrioridadeTicket {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

model Ticket {
  id          Int              @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject     String
  description String
  status      StatusTicket     @default(ABERTO)
  priority    PrioridadeTicket @default(MEDIA)
  assigneeId  Int?
  slaDueAt    DateTime?
  resolvedAt  DateTime?

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([priority])
}

model TicketMessage {
  id          Int     @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorEmail String
  body        String
  internal    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ============================================================
// PLATAFORMA: AUDITORIA (sem tenantId obrigatório)
// ============================================================

/**
 * Ações destrutivas ou sensíveis feitas pelo super admin.
 */
enum AcaoAuditoria {
  EMPRESA_CRIADA
  EMPRESA_STATUS_ALTERADO
  EMPRESA_ARQUIVADA
  ASSINATURA_ALTERADA
  PLANO_ALTERADO
  USUARIO_CRIADO
  USUARIO_ALTERADO
  USUARIO_DESATIVADO
  FUNCAO_ALTERADA
  TICKET_ALTERADO
  COMUNICACAO_ENVIADA
  CONFIGURACAO_ALTERADA
}

model PlatformAuditLog {
  id         Int           @id @default(autoincrement())
  actorEmail String
  action     AcaoAuditoria
  entity     String
  entityId   Int?
  tenantId   Int? // nulo em ações que não pertencem a uma empresa
  before     String?
  after      String?
  metadata   String?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([action])
  @@index([tenantId])
  @@index([entity])
  @@index([createdAt])
}

// ============================================================
// PLATAFORMA: COMUNICAÇÃO E SAÚDE
// ============================================================

enum StatusEnvio {
  RASCUNHO
  AGENDADO
  ENVIANDO
  ENVIADO
  FALHOU
}

enum AlvoNotificacao {
  TODAS_EMPRESAS
  POR_PLANO
  POR_EMPRESA
  POR_FUNCAO
}

model Broadcast {
  id         Int             @id @default(autoincrement())
  subject    String
  body       String
  target     AlvoNotificacao @default(TODAS_EMPRESAS)
  targetRef  String?
  status     StatusEnvio     @default(RASCUNHO)
  sentAt     DateTime?
  recipients Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum StatusIntegracao {
  CONECTADA
  DESCONECTADA
  ERRO
  PENDENTE
}

model PlatformSettings {
  id                 Int     @id @default(autoincrement())
  supportEmail       String?
  defaultTrialDays   Int     @default(14)
  defaultCurrency    String  @default("BRL")
  defaultTimezone    String  @default("America/Sao_Paulo")
  maintenanceMode    Boolean @default(false)
  auditRetentionDays Int     @default(365)

  integrations Integracao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Integracao {
  id                 Int              @id @default(autoincrement())
  platformSettingsId Int
  platformSettings   PlatformSettings @relation(fields: [platformSettingsId], references: [id], onDelete: Cascade)
  key                String
  name               String
  status             StatusIntegracao @default(PENDENTE)
  externalAccount    String?
  lastSyncAt         DateTime?
  lastError          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key])
}

/// Feature flag por empresa.
///
/// Sem esta tabela, ligar uma feature nova para 10% da base exige deploy — e o
/// deploy é o custo mais caro que existe enquanto a hipótese ainda é incerta.
/// Uma vez no ar, a feature vira decisão de produto, não de engenharia.
///
/// `tenantId` nulo = ligado para a plataforma inteira. Preenchido = só para
/// aquela empresa. Precedência na leitura: linha do tenant > linha global.
model FeatureFlag {
  id        Int      @id @default(autoincrement())
  key       String
  /// O que a flag controla. Aparece na tela do Super Admin: sem isso, quem liga
  /// a flag daqui a seis meses não descobre o que acabou de ligar.
  descricao String
  enabled   Boolean  @default(false)
  tenantId  Int?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Quem ligou. Uma flag sem autoria é um mistério em produção.
  updatedBy String?

  /// Uma flag é única no par (empresa, chave). O `key` sozinho é global,
  /// e o mercado multi-estilo só faz sentido quando a mesma chave aparece
  /// em duas empresas diferentes com status diferentes.
  @@unique([tenantId, key])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}
